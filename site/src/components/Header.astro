---
import { withBase } from '@/lib/data';

const links = [
  ['Datasets', '/datasets/'],
  ['Formats', '/formats/'],
  ['Quality', '/quality/'],
  ['Guide', '/guides/inspect-a-dataset/'],
  ['About', '/about/']
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase('/')} aria-label="NameFrame samples home">
      <img src={withBase('/brand/nameframe-mark-black.png')} width="44" height="44" alt="" />
      <span class="brand-copy">
        <span class="brand-name">Name<span>Frame</span></span>
        <small>public dataset gallery</small>
      </span>
    </a>
    <nav aria-label="Primary navigation">
      {links.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}
    </nav>
    <a class="button button-small" href="https://getnameframe.com/pilot">Apply for a pilot</a>
  </div>
</header>
