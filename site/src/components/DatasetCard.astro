---
import type { DatasetCard as Dataset } from '@/lib/data';
import { previewSrcset, previewUrl, withBase } from '@/lib/data';

interface Props { dataset: Dataset }
const { dataset } = Astro.props;
---

<article
  class="dataset-card"
  data-dataset-card
  data-capabilities={dataset.formats.join(' ').toLowerCase()}
>
  <a href={withBase(`/datasets/${dataset.slug}/`)} class="card-image">
    <img
      src={previewUrl(dataset, 'rgb')}
      srcset={previewSrcset(dataset, 'rgb')}
      sizes="(max-width: 860px) calc(100vw - 2rem), 570px"
      alt={`${dataset.name} RGB synthetic-data sample frame`}
      width={dataset.preview.width}
      height={dataset.preview.height}
      loading="lazy"
    />
  </a>
  <div class="card-body">
    <div class="eyebrow-row">
      <span class={`grade grade-${dataset.grade.letter.toLowerCase()}`}>Grade {dataset.grade.letter} · {dataset.grade.score}</span>
      <span>v{dataset.version}</span>
    </div>
    <h3><a href={withBase(`/datasets/${dataset.slug}/`)}>{dataset.name}</a></h3>
    <p>{dataset.purpose}</p>
    <dl class="compact-stats">
      <div><dt>Source run</dt><dd>{dataset.source_run.frames} frames</dd></div>
      <div><dt>Sample</dt><dd>{dataset.packaged_sample.unique_frames} frames</dd></div>
      <div><dt>Classes</dt><dd>{dataset.classes.length}</dd></div>
      <div><dt>Resolution</dt><dd>{dataset.source_run.resolution.join('×')}</dd></div>
    </dl>
    <a class="text-link" href={withBase(`/datasets/${dataset.slug}/`)}>Inspect dataset <span aria-hidden="true">→</span></a>
  </div>
</article>
